{
  "manifest_version": 3,
  "name": "bb-subsgen",
  "version": "0.0.1",
  "description": "Hover pinyin + CC-CEDICT glosses over Chinese text, on Bilibili subtitles and any site you opt into.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://*.hdslb.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["src/content/main.ts"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.bilibili.com/*"],
      "js": ["src/reader/main.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["dict/words.bin"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-pinyin": {
      "suggested_key": { "default": "Alt+P" },
      "description": "Toggle pinyin display"
    },
    "cycle-font-size": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Cycle subtitle font size"
    }
  }
}
